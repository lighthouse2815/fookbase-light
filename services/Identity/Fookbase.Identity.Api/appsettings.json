{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Fookbase.Identity",
    "Audience": "Fookbase.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Outbox": {
    "PublisherEnabled": true,
    "PollingIntervalSeconds": 2,
    "FailureBackoffSeconds": 5,
    "BatchSize": 20
  }
}
