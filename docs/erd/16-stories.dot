digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="1.1", splines=spline, fontname="Arial", fontsize=17, label="Stories", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=9, color="#167D8D", fontcolor="#35556B", arrowsize=0.7, penwidth=1.4];
"Stories" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>Stories</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AuthorUserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">MediaId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Privacy</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">int</FONT></TD></TR></TABLE>>];
"StoryMediaReferences" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>StoryMediaReferences</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">PK/FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">StoryId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">MediaId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"StoryViews" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>StoryViews</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">PK/FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">StoryId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">PK/FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ViewerUserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"StoryReactions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>StoryReactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">PK/FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">StoryId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">PK/FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">int</FONT></TD></TR></TABLE>>];
"AspNetUsers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6B7D8C"><FONT COLOR="white" POINT-SIZE="12"><B>AspNetUsers</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#667788" POINT-SIZE="9">tham chiếu từ sơ đồ khác</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"MediaAssets" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6B7D8C"><FONT COLOR="white" POINT-SIZE="12"><B>MediaAssets</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#667788" POINT-SIZE="9">tham chiếu từ sơ đồ khác</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"AspNetUsers" -> "Stories" [label="AuthorUserId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"MediaAssets" -> "Stories" [label="MediaId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"MediaAssets" -> "StoryMediaReferences" [label="MediaId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"Stories" -> "StoryMediaReferences" [label="StoryId", taillabel="1", headlabel="0..1", labeldistance=1.7, labelangle=25];
"Stories" -> "StoryViews" [label="StoryId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"AspNetUsers" -> "StoryViews" [label="ViewerUserId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"Stories" -> "StoryReactions" [label="StoryId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"AspNetUsers" -> "StoryReactions" [label="UserId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
}