"Pages" -> "PageFollowers" [label="PageId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"AspNetUsers" -> "PageFollowers" [label="UserId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"AspNetUsers" -> "PageRoleInvitations" [label="InviteeUserId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"AspNetUsers" -> "PageRoleInvitations" [label="InviterUserId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"Pages" -> "PageRoleInvitations" [label="PageId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"MediaAssets" -> "PageMediaReferences" [label="MediaId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"Pages" -> "PageMediaReferences" [label="PageId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
}