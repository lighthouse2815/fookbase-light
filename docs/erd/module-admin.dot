digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="1.1", splines=spline, fontname="Arial", fontsize=17, label="Admin — Kiểm duyệt", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=9, color="#167D8D", fontcolor="#35556B", arrowsize=0.7, penwidth=1.4];
"ModerationActions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>ModerationActions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ModeratorUserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ReportId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SubjectUserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#AF7722" POINT-SIZE="9">REF</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">TargetId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#AF7722" POINT-SIZE="9">REF</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">TargetType</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">int</FONT></TD></TR></TABLE>>];
"UserModerationStates" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>UserModerationStates</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">PK/FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"AspNetUsers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6B7D8C"><FONT COLOR="white" POINT-SIZE="12"><B>AspNetUsers</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#667788" POINT-SIZE="9">tham chiếu từ sơ đồ khác</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"ContentReports" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6B7D8C"><FONT COLOR="white" POINT-SIZE="12"><B>ContentReports</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#667788" POINT-SIZE="9">tham chiếu từ sơ đồ khác</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"AspNetUsers" -> "ModerationActions" [label="ModeratorUserId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"ContentReports" -> "ModerationActions" [label="ReportId", taillabel="0..1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"AspNetUsers" -> "ModerationActions" [label="SubjectUserId", taillabel="1", headlabel="0..n", labeldistance=1.7, labelangle=25];
"AspNetUsers" -> "UserModerationStates" [label="UserId", taillabel="1", headlabel="0..1", labeldistance=1.7, labelangle=25];
}
