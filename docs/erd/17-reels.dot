digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="1.1", splines=spline, fontname="Arial", fontsize=17, label="Lượt xem Reel", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=9, color="#167D8D", fontcolor="#35556B", arrowsize=0.7, penwidth=1.4];
"ReelViews" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>ReelViews</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#AF7722" POINT-SIZE="9">REF</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ReelPostId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#AF7722" POINT-SIZE="9">REF</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ViewerUserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"AspNetUsers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6B7D8C"><FONT COLOR="white" POINT-SIZE="12"><B>AspNetUsers</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#667788" POINT-SIZE="9">tham chiếu từ sơ đồ khác</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"Posts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#6B7D8C"><FONT COLOR="white" POINT-SIZE="12"><B>Posts</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#667788" POINT-SIZE="9">tham chiếu từ sơ đồ khác</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"Posts" -> "ReelViews" [label="ReelPostId (logic)", style=dashed, color="#B47723", fontcolor="#8E621E", arrowhead=none, constraint=false];
"AspNetUsers" -> "ReelViews" [label="ViewerUserId (logic)", style=dashed, color="#B47723", fontcolor="#8E621E", arrowhead=none, constraint=false];
}