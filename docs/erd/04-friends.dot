digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="1.1", splines=spline, fontname="Arial", fontsize=17, label="Bạn bè, theo dõi và chặn", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=9, color="#167D8D", fontcolor="#35556B", arrowsize=0.7, penwidth=1.4];
"FriendRequests" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>FriendRequests</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ReceiverUserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SenderUserId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UserId1</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UserId2</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"Friendships" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#BDD1DC" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#183B56"><FONT COLOR="white" POINT-SIZE="12"><B>Friendships</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#183B56" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UserId1</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#167D8D" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">UserId2</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#536475" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
