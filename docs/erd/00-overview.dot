digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.25", ranksep="0.7", splines=spline, pack=true, packmode="array4", fontname="Arial", fontsize=22, label="Fookbase Light — 71 bảng / 14 module + hạ tầng\nQuan hệ nội bộ từng module; bật liên kết giữa module trong trang xem", labelloc=t];
