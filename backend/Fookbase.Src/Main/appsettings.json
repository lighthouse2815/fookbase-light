{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "SensitiveAuth": {
      "LoginPermitLimit": 10,
      "RecoveryPermitLimit": 5,
      "ResendVerificationPermitLimit": 3,
      "WindowSeconds": 300
    }
  },
  "Jwt": {
    "Issuer": "Fookbase.Identity",
    "Audience": "Fookbase.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Admin": {
    "BootstrapEmail": ""
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Fookbase",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "BucketName": "fookbase-media",
    "Secure": false,
    "BucketInitializationEnabled": true,
    "BucketInitializationMaxAttempts": 5,
    "BucketInitializationRetrySeconds": 2
  },
  "Media": {
    "MaximumImageSizeBytes": 20971520,
    "MaximumVideoSizeBytes": 524288000,
    "UploadUrlExpiryMinutes": 15,
    "DownloadUrlExpiryMinutes": 5,
    "CleanupIntervalSeconds": 60,
    "CleanupBatchSize": 100,
    "VideoProcessingIntervalSeconds": 5,
    "VideoProcessingBatchSize": 1,
    "VideoProcessingTimeoutSeconds": 120,
    "VideoProcessingRetryLimit": 3,
    "VideoProcessingRetryDelaySeconds": 15,
    "MinimumReelDurationMs": 1000,
    "MaximumReelDurationMs": 180000,
    "MaximumStoryVideoDurationMs": 60000
  },
  "Stories": {
    "LifetimeHours": 24
  },
  "Posts": {
    "MaximumAttachments": 10
  }
}
