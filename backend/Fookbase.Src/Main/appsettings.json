{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30
  },
  "DataProtection": {
    "ApplicationName": "Fookbase",
    "KeyRingPath": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "SensitiveAuth": {
      "LoginPermitLimit": 10,
      "RecoveryPermitLimit": 5,
      "ResendVerificationPermitLimit": 3,
      "WindowSeconds": 300
    },
    "Search": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Issuer": "Fookbase.Identity",
    "Audience": "Fookbase.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "GoogleAuthentication": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": "",
    "WebBaseUrl": "http://localhost:5173",
    "ZolaLightBaseUrl": "http://localhost:5175"
  },
  "Admin": {
    "BootstrapEmail": ""
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Fookbase",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Media": {
    "MaximumImageSizeBytes": 20971520,
    "MaximumVideoSizeBytes": 524288000,
    "UploadUrlExpiryMinutes": 15,
    "DownloadUrlExpiryMinutes": 5,
    "CleanupIntervalSeconds": 60,
    "CleanupBatchSize": 100,
    "VideoProcessingIntervalSeconds": 5,
    "VideoProcessingBatchSize": 1,
    "MaxConcurrentJobs": 1,
    "VideoProcessingTimeoutSeconds": 120,
    "VideoProcessingRetryLimit": 3,
    "VideoProcessingRetryDelaySeconds": 15,
    "ObjectDeletionRetryLimit": 10,
    "ObjectDeletionRetryDelaySeconds": 60,
    "MinimumReelDurationMs": 1000,
    "MaximumReelDurationMs": 180000,
    "MaximumStoryVideoDurationMs": 60000
  },
  "Stories": {
    "LifetimeHours": 24
  },
  "Posts": {
    "MaximumAttachments": 10
  },
  "FeedRanking": {
    "OwnAffinity": 8,
    "FriendAffinity": 6,
    "FollowedNonFriendProfile": 5,
    "GroupAffinity": 4,
    "PageAffinity": 3,
    "SuggestedReelAffinity": 1,
    "FreshnessHoursPerPoint": 6,
    "InteractionLookbackDays": 60,
    "ReactionAffinityWeight": 1,
    "CommentAffinityWeight": 2,
    "ShareAffinityWeight": 2,
    "SaveAffinityWeight": 2,
    "ReelCompletionWeight": 3,
    "ReelStrongCompletionThreshold": 75,
    "ReelEarlyExitPenalty": 1,
    "CreatorAffinityCap": 16,
    "SourceAffinityCap": 12,
    "ReelWatchAffinityCap": 12,
    "ReactionEngagementWeight": 1,
    "CommentEngagementWeight": 1,
    "ShareEngagementWeight": 1,
    "EngagementNormalizationCap": 12,
    "EngagementMinutesPerPoint": 15,
    "CandidateLimitPerSource": 100,
    "OrganicItemsPerSuggestion": 4,
    "SuggestedReelMaxAgeDays": 7
