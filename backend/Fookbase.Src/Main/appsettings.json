{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "Fookbase.Identity",
    "Audience": "Fookbase.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "BucketName": "fookbase-media",
    "Secure": false,
    "BucketInitializationEnabled": true,
    "BucketInitializationMaxAttempts": 5,
    "BucketInitializationRetrySeconds": 2
  },
  "Media": {
    "MaximumImageSizeBytes": 20971520,
    "MaximumVideoSizeBytes": 524288000,
    "UploadUrlExpiryMinutes": 15,
    "DownloadUrlExpiryMinutes": 5,
    "CleanupIntervalSeconds": 60,
    "CleanupBatchSize": 100
  },
  "Posts": {
    "MaximumAttachments": 10
  }
}
