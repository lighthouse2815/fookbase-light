  "FriendSuggestions": {
    "DefaultPageSize": 20,
    "MaximumPageSize": 50,
    "CandidateLimitPerSource": 250,
    "MutualFriendWeight": 3,
    "SharedGroupWeight": 2,
    "SharedPageWeight": 1
