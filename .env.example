POSTGRES_USER=fookbase_identity
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=identity_db

RABBITMQ_DEFAULT_USER=fookbase
RABBITMQ_DEFAULT_PASS=change_me_for_local_development
RabbitMq__HostName=localhost
RabbitMq__Port=5672
RabbitMq__UserName=fookbase
RabbitMq__Password=change_me_for_local_development
RabbitMq__VirtualHost=/

MINIO_ROOT_USER=fookbase
MINIO_ROOT_PASSWORD=change_me_for_local_development

ConnectionStrings__IdentityDatabase="Host=localhost;Port=5432;Database=identity_db;Username=fookbase_identity;Password=change_me_for_local_development"
ConnectionStrings__UsersDatabase="Host=localhost;Port=5432;Database=users_db;Username=fookbase_identity;Password=change_me_for_local_development"
ConnectionStrings__FriendsDatabase="Host=localhost;Port=5432;Database=friends_db;Username=fookbase_identity;Password=change_me_for_local_development"
Jwt__Issuer=Fookbase.Identity
Jwt__Audience=Fookbase.Clients
Jwt__SigningKey=replace_with_at_least_32_random_characters_for_development
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=30
