POSTGRES_USER=fookbase_identity
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=fookbase_db

MINIO_ROOT_USER=fookbase
MINIO_ROOT_PASSWORD=change_me_for_local_development
Minio__Endpoint=localhost:9000
Minio__AccessKey=fookbase
Minio__SecretKey=change_me_for_local_development
Minio__BucketName=fookbase-media
Minio__Secure=false
Minio__BucketInitializationMaxAttempts=5
Minio__BucketInitializationRetrySeconds=2
MINIO_CORS_ALLOWED_ORIGIN=http://localhost:5173
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
RateLimiting__PermitLimit=120
RateLimiting__WindowSeconds=60

ConnectionStrings__FookbaseDatabase="Host=localhost;Port=5432;Database=fookbase_db;Username=fookbase_identity;Password=change_me_for_local_development"
Jwt__Issuer=Fookbase.Identity
Jwt__Audience=Fookbase.Clients
Jwt__SigningKey=replace_with_at_least_32_random_characters_for_development
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=30
Admin__BootstrapEmail=admin@example.com
Email__Enabled=false
Email__Host=smtp.example.com
Email__Port=587
Email__UseSsl=true
Email__Username=your-smtp-username
Email__Password=your-smtp-password
Email__FromAddress=no-reply@example.com
Email__FromName=Fookbase
Email__FrontendBaseUrl=http://localhost:5173
