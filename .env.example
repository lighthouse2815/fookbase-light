POSTGRES_USER=fookbase_identity
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=fookbase_db
API_PORT=5000
AllowedHosts=api.example.test

Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Database__ApplyMigrationsOnStartup=false
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=http://localhost:5175
ForwardedHeaders__Enabled=false
# Set this only when a trusted reverse proxy forwards requests to the API.
# ForwardedHeaders__KnownProxies__0=172.20.0.2
ForwardedHeaders__ForwardLimit=1
RateLimiting__PermitLimit=120
RateLimiting__WindowSeconds=60
Database__CommandTimeoutSeconds=30
Media__MaxConcurrentJobs=1
Media__ObjectDeletionRetryLimit=10
Media__ObjectDeletionRetryDelaySeconds=60

ConnectionStrings__FookbaseDatabase="Host=localhost;Port=5432;Database=fookbase_db;Username=fookbase_identity;Password=change_me_for_local_development"
Jwt__Issuer=Fookbase.Identity
Jwt__Audience=Fookbase.Clients
Jwt__SigningKey=replace_with_at_least_32_random_characters_for_development
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=30
Admin__BootstrapEmail=admin@example.com
Email__Enabled=false
Email__Host=smtp.example.com
Email__Port=587
Email__UseSsl=true
Email__Username=your-smtp-username
Email__Password=your-smtp-password
Email__FromAddress=no-reply@example.com
Email__FromName=Fookbase
Email__FrontendBaseUrl=http://localhost:5173

# SMS is optional. For Traccar, set Provider=Traccar, its Cloud Service URL and Cloud Token.
# Never commit a real access token or put it in a VITE_* variable.
Sms__Enabled=false
Sms__Provider=Traccar
Sms__AccessToken=
Sms__TwoFactorApplicationId=
Sms__BaseUrl=https://www.traccar.org/sms/

# Google OAuth credentials are server-only. Never put either value in VITE_* variables.
GoogleAuthentication__Enabled=false
GoogleAuthentication__ClientId=
GoogleAuthentication__ClientSecret=
GoogleAuthentication__WebBaseUrl=http://localhost:5173
GoogleAuthentication__ZolaLightBaseUrl=http://localhost:5175

# AI chat is disabled by default. The key stays on the API server; never use a VITE_* variable.
AiChat__Enabled=false
# Providers are tried in this order when they have a key: Groq, Gemini, OpenRouter.
AiChat__Groq__ApiKey=
AiChat__Groq__ApiBaseUrl=https://api.groq.com/openai/v1/
AiChat__Groq__Model=openai/gpt-oss-120b
AiChat__Gemini__ApiKey=
AiChat__Gemini__ApiBaseUrl=https://generativelanguage.googleapis.com/
AiChat__Gemini__Model=gemini-2.5-flash-lite
AiChat__OpenRouter__ApiKey=
AiChat__OpenRouter__ApiBaseUrl=https://openrouter.ai/api/v1/
AiChat__OpenRouter__Model=openrouter/free
AiChat__RequestTimeoutSeconds=45
AiChat__MaximumInputCharacters=4000
AiChat__MaximumHistoryMessages=10
RateLimiting__AiChat__PermitLimit=10
RateLimiting__AiChat__WindowSeconds=60

# Frontend build-time configuration. Do not put credentials in VITE_* values.
VITE_ZOLA_LIGHT_URL=http://localhost:5175
